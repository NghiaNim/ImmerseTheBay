# Copy to portal/.env (gitignored) and fill in. Never commit the real file.

# Reactor API key from reactor.inc/dashboard -> API Keys (starts with rk_). Used ONLY by this server to mint short-lived JWTs.
REACTOR_API_KEY=rk_your_key_here

# Port the portal listens on (all interfaces, so the Beam Pro can reach it over Wi-Fi).
PORT=8790

# Optional shared secret. If set, /api/token and /sync require header/query "portal_token" = this value.
# Put the same value in Assets/StreamingAssets/visko.json -> "portalToken".
PORTAL_TOKEN=

# Token lifetime in seconds (max 21600 = 6 h). A session cannot outlive its token, so keep it long.
TOKEN_TTL_SECONDS=21600

# Server-side lesson agent and spontaneous branch planning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
